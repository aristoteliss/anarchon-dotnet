root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
max_line_length = 120

# Every source file starts with the license header.
file_header_template = Copyright (C) 2026-present Aristotelis — see repository license.
dotnet_diagnostic.IDE0073.severity = warning

# Layout
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = when_multiline:warning
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent

# Language
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_readonly_field = true:warning
csharp_style_prefer_primary_constructors = false:silent
dotnet_diagnostic.IDE0005.severity = warning

# Naming: private fields are _camelCase; constants and static readonly fields PascalCase.
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal
dotnet_naming_rule.constants.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.static_readonly.symbols = static_readonly
dotnet_naming_rule.static_readonly.style = pascal
dotnet_naming_rule.static_readonly.severity = warning
dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly

dotnet_naming_rule.constants.priority = 1
dotnet_naming_rule.static_readonly.priority = 2
dotnet_naming_rule.private_fields.priority = 3

# Analyzer choices
# A library awaits without the caller's context.
dotnet_diagnostic.CA2007.severity = warning
# Exceptions are rethrown or reported as events on purpose: the scheduler never lets a job's error escape.
dotnet_diagnostic.CA1031.severity = none
# Messages are in English only.
dotnet_diagnostic.CA1303.severity = none
# Jitter and backup timing need no cryptographic randomness.
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.CA1716.severity = none
