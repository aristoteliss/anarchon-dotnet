<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Anarchon.SqlServer</RootNamespace>
    <Description>SQL Server and Azure SQL backend for Anarchon, on Microsoft.Data.SqlClient: one short transaction claims each run, with backup runners, retries, catch-up and no overlapping runs. Leases run on the database's clock.</Description>
    <PackageTags>$(PackageTags);sqlserver;mssql;azure-sql;sqlclient</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Anarchon.Sql/Anarchon.Sql.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
</Project>
