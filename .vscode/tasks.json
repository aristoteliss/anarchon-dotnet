{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Anarchon.slnx"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test servers: up",
      "type": "shell",
      "command": "docker compose -f test/docker-compose.test.yml up -d --wait",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
