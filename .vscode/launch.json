{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Example: QuickStart (3 processes: graceful stop, crash, downtime)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/examples/QuickStart/bin/Debug/net10.0/QuickStart.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Example: Basic (console; run it in 3 terminals)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/examples/Basic/bin/Debug/net10.0/Basic.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Example: Hosting (worker service with attributes, Redis)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/examples/Hosting/bin/Debug/net10.0/Hosting.dll",
      "cwd": "${workspaceFolder}/examples/Hosting",
      "console": "integratedTerminal"
    },
    {
